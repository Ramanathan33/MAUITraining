<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:searchHandlers="clr-namespace:JobCartAPI.SearchHandlers"
             xmlns:models="clr-namespace:JobCartAPI.Entities"
             xmlns:viewModels="clr-namespace:JobCartAPI.ViewModels"
             x:Class="JobCartAPI.JobListPage"
             x:Name="JobListRoot"
             x:DataType="viewModels:JobListViewModel"
             Title="{Binding Title}">

    <Shell.SearchHandler>
        <searchHandlers:JobCardSearchHandler
            Placeholder="Search name, mobile, or model"
            ShowsResults="True"
            JobCards="{x:Static viewModels:JobListViewModel.JobCartsListForSearch}">
            <searchHandlers:JobCardSearchHandler.ItemTemplate>
                <DataTemplate x:DataType="models:JobCardModel">
                    <VerticalStackLayout Padding="12,8">
                        <Label Text="{Binding CustomerName}" FontSize="16" />
                        <Label Text="{Binding SummaryLine}"
                               FontSize="12"
                               IsVisible="{Binding HasSummary}"
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </searchHandlers:JobCardSearchHandler.ItemTemplate>
        </searchHandlers:JobCardSearchHandler>
    </Shell.SearchHandler>

    <Grid RowDefinitions="Auto,Auto,*" Margin="16,12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Service job cards" FontSize="22" FontAttributes="Bold" />
                <Label Text="{Binding JobCountText}" TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Add Job"
                    Command="{Binding AddJobCommand}"
                    VerticalOptions="Center" />
        </Grid>

        <Picker Grid.Row="1"
                Margin="0,12,0,4"
                Title="Filter by status"
                ItemsSource="{Binding StatusFilters}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedStatusFilter}" />

        <Grid Grid.Row="2">
            <RefreshView Command="{Binding GetJobListCommand}"
                         IsRefreshing="{Binding IsRefreshing}">
                <CollectionView ItemsSource="{Binding JobCarts}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Null}">
                            <Frame Margin="0,6" Padding="12">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                    <Label Text="{Binding CustomerName}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding StatusName}"
                                           TextColor="{StaticResource Primary}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding SummaryLine}"
                                           IsVisible="{Binding HasSummary}"
                                           TextColor="{StaticResource Gray500}" />
                                    <Label Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding ScheduleText}"
                                           IsVisible="{Binding HasSchedule}" />
                                    <Label Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding ComplaintPreview}"
                                           IsVisible="{Binding HasComplaint}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Grid.Row="4"
                                                           Grid.ColumnSpan="2"
                                                           Spacing="8"
                                                           HorizontalOptions="End">
                                        <Button Text="Edit"
                                                Padding="12,6"
                                                Command="{Binding BindingContext.EditJobCommand, Source={x:Reference JobListRoot}}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Delete"
                                                Padding="12,6"
                                                BackgroundColor="Transparent"
                                                TextColor="#B00020"
                                                Command="{Binding BindingContext.DeleteJobCommand, Source={x:Reference JobListRoot}}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Label Text="{Binding EmptyMessage}"
                   IsVisible="{Binding ShowEmpty}"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   Margin="24"
                   TextColor="{StaticResource Gray500}" />

            <ActivityIndicator IsRunning="{Binding ShowLoading}"
                               IsVisible="{Binding ShowLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
